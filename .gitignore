tests/



# Ignore everything under these directories by default
/logs/**
/source/lander_assets/**
/source/STTR/**

# Allow Git to traverse subdirectories
!/logs/
!/logs/IsaacLab/
!/logs/IsaacLab/**/
!/source/lander_assets/
!/source/lander_assets/**/

# Only allow selected file types
!/logs/IsaacLab/**/*.pt
!/logs/IsaacLab/**/*.pkl
!/logs/IsaacLab/**/*.yaml

!/source/lander_assets/**/*.usd
!/source/lander_assets/**/*.hdr
!/source/lander_assets/**/*.jpg
!/source/lander_assets/**/*.png


# Docker history
.isaac-lab-docker-history

